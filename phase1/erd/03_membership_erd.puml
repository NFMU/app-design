@startuml 03_membership_erd
hide circle
hide empty members
skinparam shadowing false
skinparam linetype ortho

skinparam class {
  FontSize 13
  FontName Arial
  FontStyle bold
  FontColor #212121
  BorderThickness 1.5
  RoundCorner 10
}
skinparam arrow {
  Color #90A4AE
  FontSize 10
  FontColor #546E7A
}

title <size:15><b>Membership & Invitation</b></size>\n

' ── STUB ENTITIES ────────────────────────────

class users    #ECEFF1 ##B0BEC5
class tenants  #ECEFF1 ##B0BEC5
class channels #ECEFF1 ##B0BEC5

' ── DOMAIN ENTITIES ──────────────────────────

class tenant_members #FEF9C3 ##B7950B
class channel_members #FEF9C3 ##B7950B
class invitations    #FEF9C3 ##B7950B

' ── RELATIONSHIPS ────────────────────────────

' Tenant membership
tenants  ||--o{ tenant_members  : "has"
users    ||--o{ tenant_members  : "joins"
users    ||--o{ tenant_members  : "invited by"

' Channel membership
channels ||--o{ channel_members : "has"
users    ||--o{ channel_members : "joins"
users    ||--o{ channel_members : "added by"

' Invitations
tenants  ||--o{ invitations     : "sends"
channels ||--o{ invitations     : "targets"
users    ||--o{ invitations     : "invited by"
users    ||--o{ invitations     : "accepted by"

@enduml
