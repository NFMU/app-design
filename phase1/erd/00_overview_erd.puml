@startuml 00_overview_erd
hide circle
hide empty members
skinparam shadowing false
skinparam linetype ortho

skinparam class {
  FontSize 13
  FontName Arial
  FontStyle bold
  FontColor #212121
  BorderThickness 1.5
  RoundCorner 10
}
skinparam arrow {
  Color #90A4AE
  FontSize 10
  FontColor #546E7A
}
skinparam package {
  BackgroundColor transparent
  BorderColor #B0BEC5
  BorderThickness 1.5
  FontSize 12
  FontStyle bold
  FontColor #37474F
}

title <size:16><b>Phase 1 — Full ERD Overview</b></size>\n

' ── Identity & User Management ───────────────
package "Identity & User Management" #EBF5FB {
  class users         #D6EAF8
  class user_profiles #D6EAF8
  class user_settings #D6EAF8
  class user_sessions #D6EAF8
  class password_resets #D6EAF8
}

' ── Tenant & Subscription ────────────────────
package "Tenant & Subscription" #EAFAF1 {
  class plans   #D5F5E3
  class tenants #D5F5E3
}

' ── Membership & Invitation ──────────────────
package "Membership & Invitation" #FEFDE7 {
  class tenant_members #FEF9C3
  class invitations    #FEF9C3
}

' ── Channel ──────────────────────────────────
package "Channel" #FEF5E7 {
  class channels        #FDEBD0
  class channel_members #FDEBD0
}

' ── Chat & Messaging ─────────────────────────
package "Chat & Messaging" #FDF2F8 {
  class messages            #FADBD8
  class message_reads       #FADBD8
  class message_pins        #FADBD8
  class message_attachments #FADBD8
}

' ── RBAC ─────────────────────────────────────
package "RBAC" #F5EEF8 {
  class roles               #E8DAEF
  class permissions         #E8DAEF
  class role_permissions    #E8DAEF
  class tenant_member_roles #E8DAEF
  class channel_member_roles #E8DAEF
}

' ── RELATIONSHIPS ────────────────────────────

' Identity
users              ||--||  user_profiles   : "has"
users              ||--||  user_settings   : "has"
users              ||--o{  user_sessions   : "opens"
users              ||--o{  password_resets : "requests"

' Tenant
plans              ||--o{  tenants         : "applied to"
users              ||--o{  tenants         : "creates / owns"

' Membership
tenants            ||--o{  tenant_members  : "has"
users              ||--o{  tenant_members  : "joins"
tenants            ||--o{  invitations     : "sends"
channels           ||--o{  invitations     : "targets"
users              ||--o{  invitations     : "invited by"

' Channel
tenants            ||--o{  channels        : "has"
users              ||--o{  channels        : "creates"
channels           ||--o{  channel_members : "has"
users              ||--o{  channel_members : "joins"

' Messaging
channels           ||--o{  messages            : "has"
users              ||--o{  messages            : "sends"
messages           ||--o{  messages            : "reply to"
messages           ||--o{  message_reads       : "tracked by"
messages           ||--o{  message_pins        : "pinned as"
messages           ||--o{  message_attachments : "has"
channels           ||--o{  message_reads       : "tracks"
channels           ||--o{  message_pins        : "has"
users              ||--o{  message_reads       : "reads"
users              ||--o{  message_pins        : "pins"

' RBAC
tenants            ||--o{  roles                : "defines"
roles              ||--o{  role_permissions     : "has"
permissions        ||--o{  role_permissions     : "granted via"
tenant_members     ||--o{  tenant_member_roles  : "assigned"
roles              ||--o{  tenant_member_roles  : "applied to"
channel_members    ||--o{  channel_member_roles : "assigned"
roles              ||--o{  channel_member_roles : "applied to"

@enduml
