@startuml 05_chat_erd
hide circle
hide empty members
skinparam shadowing false
skinparam linetype ortho

skinparam class {
  FontSize 13
  FontName Arial
  FontStyle bold
  FontColor #212121
  BorderThickness 1.5
  RoundCorner 10
}
skinparam arrow {
  Color #90A4AE
  FontSize 10
  FontColor #546E7A
}

title <size:15><b>Chat & Messaging</b></size>\n

' ── STUB ENTITIES ────────────────────────────

class users    #ECEFF1 ##B0BEC5
class channels #ECEFF1 ##B0BEC5

' ── DOMAIN ENTITIES ──────────────────────────

class messages            #FADBD8 ##7B241C
class message_reads       #FADBD8 ##7B241C
class message_pins        #FADBD8 ##7B241C
class message_attachments #FADBD8 ##7B241C

' ── RELATIONSHIPS ────────────────────────────

' Core
channels ||--o{ messages            : "has"
users    ||--o{ messages            : "sends"
messages ||--o{ messages            : "reply to"

' Reads
channels ||--o{ message_reads       : "tracks"
users    ||--o{ message_reads       : "reads"
messages ||--o{ message_reads       : "tracked by"

' Pins
channels ||--o{ message_pins        : "has"
messages ||--o{ message_pins        : "pinned as"
users    ||--o{ message_pins        : "pins"

' Attachments
messages ||--o{ message_attachments : "has"

@enduml
