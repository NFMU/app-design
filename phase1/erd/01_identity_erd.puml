@startuml 01_identity_erd
hide circle
hide empty members
skinparam shadowing false
skinparam linetype ortho

skinparam class {
  FontSize 13
  FontName Arial
  FontStyle bold
  FontColor #212121
  BorderThickness 1.5
  RoundCorner 10
}
skinparam arrow {
  Color #90A4AE
  FontSize 10
  FontColor #546E7A
}

title <size:15><b>Identity & User Management</b></size>\n

' ── ENTITIES ─────────────────────────────────

class users          #D6EAF8 ##1A5276
class user_profiles  #D6EAF8 ##1A5276
class user_settings  #D6EAF8 ##1A5276
class user_sessions  #D6EAF8 ##1A5276
class password_resets #D6EAF8 ##1A5276

' ── RELATIONSHIPS ────────────────────────────

users ||--||  user_profiles   : "has profile"
users ||--||  user_settings   : "has settings"
users ||--o{  user_sessions   : "opens session"
users ||--o{  password_resets : "requests reset"

@enduml
