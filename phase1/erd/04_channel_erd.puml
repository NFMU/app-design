@startuml 04_channel_erd
hide circle
hide empty members
skinparam shadowing false
skinparam linetype ortho

skinparam class {
  FontSize 13
  FontName Arial
  FontStyle bold
  FontColor #212121
  BorderThickness 1.5
  RoundCorner 10
}
skinparam arrow {
  Color #90A4AE
  FontSize 10
  FontColor #546E7A
}

title <size:15><b>Channel Management</b></size>\n

' ── STUB ENTITIES ────────────────────────────

class users   #ECEFF1 ##B0BEC5
class tenants #ECEFF1 ##B0BEC5

' ── DOMAIN ENTITIES ──────────────────────────

class channels        #FDEBD0 ##A04000
class channel_members #FDEBD0 ##A04000

' ── RELATIONSHIPS ────────────────────────────

tenants  ||--o{ channels        : "has"
users    ||--o{ channels        : "creates"
channels ||--o{ channel_members : "has"
users    ||--o{ channel_members : "joins"
users    ||--o{ channel_members : "added by"

@enduml
