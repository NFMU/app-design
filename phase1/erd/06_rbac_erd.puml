@startuml 06_rbac_erd
hide circle
hide empty members
skinparam shadowing false
skinparam linetype ortho

skinparam class {
  FontSize 13
  FontName Arial
  FontStyle bold
  FontColor #212121
  BorderThickness 1.5
  RoundCorner 10
}
skinparam arrow {
  Color #90A4AE
  FontSize 10
  FontColor #546E7A
}

title <size:15><b>Role-Based Access Control (RBAC)</b></size>\n

' ── STUB ENTITIES ────────────────────────────

class users           #ECEFF1 ##B0BEC5
class tenants         #ECEFF1 ##B0BEC5
class tenant_members  #ECEFF1 ##B0BEC5
class channel_members #ECEFF1 ##B0BEC5

' ── DOMAIN ENTITIES ──────────────────────────

class roles                #E8DAEF ##6C3483
class permissions          #E8DAEF ##6C3483
class role_permissions     #E8DAEF ##6C3483
class tenant_member_roles  #E8DAEF ##6C3483
class channel_member_roles #E8DAEF ##6C3483

' ── RELATIONSHIPS ────────────────────────────

' Role definitions
tenants         ||--o{ roles                : "defines"
roles           ||--o{ role_permissions     : "has"
permissions     ||--o{ role_permissions     : "granted via"

' Tenant-level assignments
tenant_members  ||--o{ tenant_member_roles  : "assigned"
roles           ||--o{ tenant_member_roles  : "applied to"
users           ||--o{ tenant_member_roles  : "assigned by"

' Channel-level assignments
channel_members ||--o{ channel_member_roles : "assigned"
roles           ||--o{ channel_member_roles : "applied to"
users           ||--o{ channel_member_roles : "assigned by"

@enduml
