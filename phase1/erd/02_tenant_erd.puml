@startuml 02_tenant_erd
hide circle
hide empty members
skinparam shadowing false
skinparam linetype ortho

skinparam class {
  FontSize 13
  FontName Arial
  FontStyle bold
  FontColor #212121
  BorderThickness 1.5
  RoundCorner 10
}
skinparam arrow {
  Color #90A4AE
  FontSize 10
  FontColor #546E7A
}

title <size:15><b>Tenant & Subscription</b></size>\n

' ── STUB ENTITIES ────────────────────────────

class users #ECEFF1 ##B0BEC5

' ── DOMAIN ENTITIES ──────────────────────────

class plans   #D5F5E3 ##1E8449
class tenants #D5F5E3 ##1E8449

' ── RELATIONSHIPS ────────────────────────────

plans  ||--o{ tenants : "applied to"
users  ||--o{ tenants : "creates"
users  ||--o{ tenants : "owns"

@enduml
