@startuml 08_workspace_erd
hide circle
hide empty members
skinparam shadowing false
skinparam linetype ortho

skinparam class {
  FontSize 13
  FontName Arial
  FontStyle bold
  FontColor #212121
  BorderThickness 1.5
  RoundCorner 10
}
skinparam arrow {
  Color #90A4AE
  FontSize 10
  FontColor #546E7A
}

title <size:15><b>Workspace Domain</b></size>\n

' ── ENTITIES ─────────────────────────────────

class users             #D6EAF8 ##1A5276
class workspaces        #D5F5E3 ##1E8449
class workspace_groups  #D5F5E3 ##1E8449
class memberships       #FEF9C3 ##B7950B
class group_members     #FEF9C3 ##B7950B
class workspace_invites #FDEBD0 ##A04000

' ── RELATIONSHIPS ────────────────────────────

users             ||--o{ workspaces        : "creates"
users             ||--o{ workspaces        : "owns"
users             ||--o{ workspace_groups  : "creates"
workspaces        ||--o{ workspace_groups  : "contains"
workspaces        ||--o{ memberships       : "has"
users             ||--o{ memberships       : "belongs to"
workspace_groups  ||--o{ group_members     : "has"
memberships       ||--o{ group_members     : "joins"
users             ||--o{ workspace_invites : "invites"
workspaces        ||--o{ workspace_invites : "sends"

@enduml
