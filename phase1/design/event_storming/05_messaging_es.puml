@startuml 05_messaging_es
title Messaging Domain - Event Storming
left to right direction

skinparam defaultTextAlignment center
skinparam rectangle {
  RoundCorner 8
  BackgroundColor<<Command>>       #1565C0
  FontColor<<Command>>             white
  BorderColor<<Command>>           #0D47A1
  BackgroundColor<<Event>>         #E65100
  FontColor<<Event>>               white
  BorderColor<<Event>>             #BF360C
  BackgroundColor<<Aggregate>>     #F9A825
  FontColor<<Aggregate>>           #212121
  BorderColor<<Aggregate>>         #F57F17
  BackgroundColor<<Policy>>        #6A1B9A
  FontColor<<Policy>>              white
  BorderColor<<Policy>>            #4A148C
  BackgroundColor<<ReadModel>>     #1B5E20
  FontColor<<ReadModel>>           white
  BorderColor<<ReadModel>>         #194D19
  BackgroundColor<<External>>      #880E4F
  FontColor<<External>>            white
  BorderColor<<External>>          #560027
}
skinparam actor {
  BackgroundColor #FFFDE7
  BorderColor     #F9A825
}
skinparam ArrowColor #555555

actor "Member"  as member
actor "Admin"   as admin

' ============================================================
' AGGREGATES
' ============================================================
rectangle "Message\nAggregate" <<Aggregate>> as aggMsg

' ============================================================
' SEND MESSAGE FLOW
' ============================================================
rectangle "SendMessage\n[channel_id, content, type]"   <<Command>>    as cmdSend
rectangle "MessageSent"                                  <<Event>>      as evtSent
rectangle "NotifyChannelMembers"                         <<Policy>>     as polNotify
rectangle "PushNotification\nService"                    <<External>>   as sysPush
rectangle "Channel Feed\n[read model]"                   <<ReadModel>>  as rmFeed
rectangle "Unread Count\n[read model]"                   <<ReadModel>>  as rmUnread

member     -->  cmdSend
cmdSend    -->  aggMsg
aggMsg     -->  evtSent
evtSent    -[#6A1B9A]->  polNotify : triggers
polNotify  -->  sysPush
evtSent    -->  rmFeed
evtSent    -->  rmUnread : increments

' ============================================================
' REPLY (THREAD) FLOW
' ============================================================
rectangle "ReplyToMessage\n[parent_msg_id, content]"  <<Command>>    as cmdReply
rectangle "MessageReplied"                              <<Event>>      as evtReplied
rectangle "Thread View\n[read model]"                  <<ReadModel>>  as rmThread

member     -->  cmdReply
cmdReply   -->  aggMsg
aggMsg     -->  evtReplied
evtReplied -->  rmThread

' ============================================================
' EDIT MESSAGE FLOW
' ============================================================
rectangle "EditMessage\n[message_id, content]"  <<Command>>  as cmdEdit
rectangle "MessageEdited"                        <<Event>>    as evtEdited

member     -->  cmdEdit
cmdEdit    -->  aggMsg
aggMsg     -->  evtEdited
evtEdited  -->  rmFeed : updates

' ============================================================
' DELETE MESSAGE FLOW
' ============================================================
rectangle "DeleteMessage\n[message_id]"  <<Command>>  as cmdDelete
rectangle "MessageDeleted"               <<Event>>    as evtDeleted

member     -->  cmdDelete
cmdDelete  -->  aggMsg
aggMsg     -->  evtDeleted
evtDeleted -->  rmFeed : soft-removes

' ============================================================
' READ / MARK FLOW
' ============================================================
rectangle "MarkChannelRead\n[channel_id, message_id]"  <<Command>>    as cmdRead
rectangle "ChannelMarkedRead"                           <<Event>>      as evtRead

member    -->  cmdRead
cmdRead   -->  aggMsg
aggMsg    -->  evtRead
evtRead   -->  rmUnread : resets

' ============================================================
' PIN MESSAGE FLOW
' ============================================================
rectangle "PinMessage\n[message_id]"    <<Command>>    as cmdPin
rectangle "MessagePinned"               <<Event>>      as evtPinned
rectangle "UnpinMessage\n[message_id]"  <<Command>>    as cmdUnpin
rectangle "MessageUnpinned"             <<Event>>      as evtUnpinned
rectangle "Pinned Messages\n[read model]" <<ReadModel>> as rmPins

admin      -->  cmdPin
cmdPin     -->  aggMsg
aggMsg     -->  evtPinned
evtPinned  -->  rmPins

admin      -->  cmdUnpin
cmdUnpin   -->  aggMsg
aggMsg     -->  evtUnpinned
evtUnpinned -->  rmPins : removes

' ============================================================
' ATTACH FILE FLOW
' ============================================================
rectangle "AttachFile\n[message_id, file]"   <<Command>>   as cmdAttach
rectangle "FileAttached"                      <<Event>>     as evtAttach
rectangle "StorageService"                    <<External>>  as sysStorage

member     -->  cmdAttach
cmdAttach  -->  aggMsg
aggMsg     -->  evtAttach
evtAttach  -->  sysStorage : stores file

@enduml
