@startuml 02_workspace_es
title Workspace Domain - Event Storming
left to right direction

skinparam defaultTextAlignment center
skinparam rectangle {
  RoundCorner 8
  BackgroundColor<<Command>>       #1565C0
  FontColor<<Command>>             white
  BorderColor<<Command>>           #0D47A1
  BackgroundColor<<Event>>         #E65100
  FontColor<<Event>>               white
  BorderColor<<Event>>             #BF360C
  BackgroundColor<<Aggregate>>     #F9A825
  FontColor<<Aggregate>>           #212121
  BorderColor<<Aggregate>>         #F57F17
  BackgroundColor<<Policy>>        #6A1B9A
  FontColor<<Policy>>              white
  BorderColor<<Policy>>            #4A148C
  BackgroundColor<<ReadModel>>     #1B5E20
  FontColor<<ReadModel>>           white
  BorderColor<<ReadModel>>         #194D19
  BackgroundColor<<External>>      #880E4F
  FontColor<<External>>            white
  BorderColor<<External>>          #560027
}
skinparam actor {
  BackgroundColor #FFFDE7
  BorderColor     #F9A825
}
skinparam ArrowColor #555555

actor "User\n(Owner)"  as owner
actor "System\nAdmin"  as sysAdmin

' ============================================================
' AGGREGATES
' ============================================================
rectangle "Workspace\nAggregate" <<Aggregate>> as aggWorkspace

' ============================================================
' CREATE WORKSPACE FLOW
' ============================================================
rectangle "CreateWorkspace\n[name, slug, plan_id]"   <<Command>>    as cmdCreate
rectangle "WorkspaceCreated"                          <<Event>>      as evtCreated
rectangle "AssignOwnerRole"                           <<Policy>>     as polOwner
rectangle "RoleAssigned\n(owner)"                     <<Event>>      as evtOwner
rectangle "Workspace List\n[read model]"              <<ReadModel>>  as rmList

owner       -->  cmdCreate
cmdCreate   -->  aggWorkspace
aggWorkspace -->  evtCreated
evtCreated  -[#6A1B9A]->  polOwner  : triggers
polOwner    -->  evtOwner
evtCreated  -->  rmList

' ============================================================
' UPDATE WORKSPACE FLOW
' ============================================================
rectangle "UpdateWorkspace\n[name, settings, branding]"  <<Command>>    as cmdUpdate
rectangle "WorkspaceUpdated"                              <<Event>>      as evtUpdated
rectangle "Workspace Detail\n[read model]"                <<ReadModel>>  as rmDetail

owner       -->  cmdUpdate
cmdUpdate   -->  aggWorkspace
aggWorkspace -->  evtUpdated
evtUpdated  -->  rmDetail

' ============================================================
' SUSPEND / ACTIVATE FLOW
' ============================================================
rectangle "SuspendWorkspace"     <<Command>>  as cmdSuspend
rectangle "WorkspaceSuspended"   <<Event>>    as evtSuspended
rectangle "NotifyMembers"        <<Policy>>   as polNotify
rectangle "ActivateWorkspace"    <<Command>>  as cmdActivate
rectangle "WorkspaceActivated"   <<Event>>    as evtActivated

sysAdmin    -->  cmdSuspend
cmdSuspend  -->  aggWorkspace
aggWorkspace -->  evtSuspended
evtSuspended -[#6A1B9A]->  polNotify : triggers

sysAdmin    -->  cmdActivate
cmdActivate -->  aggWorkspace
aggWorkspace -->  evtActivated

' ============================================================
' DELETE WORKSPACE FLOW
' ============================================================
rectangle "DeleteWorkspace"    <<Command>>  as cmdDelete
rectangle "WorkspaceDeleted"   <<Event>>    as evtDeleted
rectangle "CleanupResources"   <<Policy>>   as polCleanup

owner       -->  cmdDelete
cmdDelete   -->  aggWorkspace
aggWorkspace -->  evtDeleted
evtDeleted  -[#6A1B9A]->  polCleanup : triggers

@enduml
