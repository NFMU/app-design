@startuml 04_channel_es
title Channel Domain - Event Storming
left to right direction

skinparam defaultTextAlignment center
skinparam rectangle {
  RoundCorner 8
  BackgroundColor<<Command>>       #1565C0
  FontColor<<Command>>             white
  BorderColor<<Command>>           #0D47A1
  BackgroundColor<<Event>>         #E65100
  FontColor<<Event>>               white
  BorderColor<<Event>>             #BF360C
  BackgroundColor<<Aggregate>>     #F9A825
  FontColor<<Aggregate>>           #212121
  BorderColor<<Aggregate>>         #F57F17
  BackgroundColor<<Policy>>        #6A1B9A
  FontColor<<Policy>>              white
  BorderColor<<Policy>>            #4A148C
  BackgroundColor<<ReadModel>>     #1B5E20
  FontColor<<ReadModel>>           white
  BorderColor<<ReadModel>>         #194D19
  BackgroundColor<<External>>      #880E4F
  FontColor<<External>>            white
  BorderColor<<External>>          #560027
}
skinparam actor {
  BackgroundColor #FFFDE7
  BorderColor     #F9A825
}
skinparam ArrowColor #555555

actor "Member"        as member
actor "Admin"         as admin

' ============================================================
' AGGREGATES
' ============================================================
rectangle "Channel\nAggregate" <<Aggregate>> as aggChannel

' ============================================================
' CREATE CHANNEL FLOW
' ============================================================
rectangle "CreateChannel\n[name, type, tenant_id]"  <<Command>>    as cmdCreate
rectangle "ChannelCreated"                           <<Event>>      as evtCreated
rectangle "AddCreatorAsMember"                       <<Policy>>     as polCreator
rectangle "ChannelMemberAdded\n(creator → admin)"   <<Event>>      as evtCreatorAdded
rectangle "Channel List\n[read model]"               <<ReadModel>>  as rmList

member      -->  cmdCreate
cmdCreate   -->  aggChannel
aggChannel  -->  evtCreated
evtCreated  -[#6A1B9A]->  polCreator : triggers
polCreator  -->  evtCreatorAdded
evtCreated  -->  rmList

' ============================================================
' JOIN CHANNEL FLOW
' ============================================================
rectangle "JoinChannel\n[channel_id]"        <<Command>>    as cmdJoin
rectangle "ChannelMemberAdded"               <<Event>>      as evtJoined
rectangle "Channel Members\n[read model]"    <<ReadModel>>  as rmMembers

member     -->  cmdJoin
cmdJoin    -->  aggChannel
aggChannel -->  evtJoined
evtJoined  -->  rmMembers

' ============================================================
' INVITE TO CHANNEL FLOW
' ============================================================
rectangle "InviteToChannel\n[email, channel_id]"  <<Command>>  as cmdInvite
rectangle "ChannelInvitationSent"                  <<Event>>    as evtInviteSent

admin      -->  cmdInvite
cmdInvite  -->  aggChannel
aggChannel -->  evtInviteSent

' ============================================================
' LEAVE / REMOVE FLOW
' ============================================================
rectangle "LeaveChannel"          <<Command>>  as cmdLeave
rectangle "ChannelMemberLeft"     <<Event>>    as evtLeft
rectangle "RemoveChannelMember\n[member_id]"  <<Command>>  as cmdRemove
rectangle "ChannelMemberRemoved"  <<Event>>    as evtRemoved

member     -->  cmdLeave
cmdLeave   -->  aggChannel
aggChannel -->  evtLeft
evtLeft    -->  rmMembers : updates

admin      -->  cmdRemove
cmdRemove  -->  aggChannel
aggChannel -->  evtRemoved
evtRemoved -->  rmMembers : updates

' ============================================================
' UPDATE / ARCHIVE CHANNEL FLOW
' ============================================================
rectangle "UpdateChannel\n[name, topic, settings]"  <<Command>>    as cmdUpdate
rectangle "ChannelUpdated"                           <<Event>>      as evtUpdated
rectangle "ArchiveChannel"                           <<Command>>    as cmdArchive
rectangle "ChannelArchived"                          <<Event>>      as evtArchived
rectangle "NotifyChannelMembers"                     <<Policy>>     as polNotify
rectangle "Channel Detail\n[read model]"             <<ReadModel>>  as rmDetail

admin      -->  cmdUpdate
cmdUpdate  -->  aggChannel
aggChannel -->  evtUpdated
evtUpdated -->  rmDetail

admin      -->  cmdArchive
cmdArchive -->  aggChannel
aggChannel -->  evtArchived
evtArchived -[#6A1B9A]->  polNotify : triggers

@enduml
