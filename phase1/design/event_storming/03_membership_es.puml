@startuml 03_membership_es
title Membership & Invitation Domain - Event Storming
left to right direction

skinparam defaultTextAlignment center
skinparam rectangle {
  RoundCorner 8
  BackgroundColor<<Command>>       #1565C0
  FontColor<<Command>>             white
  BorderColor<<Command>>           #0D47A1
  BackgroundColor<<Event>>         #E65100
  FontColor<<Event>>               white
  BorderColor<<Event>>             #BF360C
  BackgroundColor<<Aggregate>>     #F9A825
  FontColor<<Aggregate>>           #212121
  BorderColor<<Aggregate>>         #F57F17
  BackgroundColor<<Policy>>        #6A1B9A
  FontColor<<Policy>>              white
  BorderColor<<Policy>>            #4A148C
  BackgroundColor<<ReadModel>>     #1B5E20
  FontColor<<ReadModel>>           white
  BorderColor<<ReadModel>>         #194D19
  BackgroundColor<<External>>      #880E4F
  FontColor<<External>>            white
  BorderColor<<External>>          #560027
}
skinparam actor {
  BackgroundColor #FFFDE7
  BorderColor     #F9A825
}
skinparam ArrowColor #555555

actor "Member\n(Admin)"  as admin
actor "Invitee"          as invitee
actor "Member"           as member

' ============================================================
' AGGREGATES
' ============================================================
rectangle "Invitation\nAggregate"   <<Aggregate>> as aggInvite
rectangle "Membership\nAggregate"   <<Aggregate>> as aggMember

' ============================================================
' INVITE FLOW
' ============================================================
rectangle "InviteUser\n[email, role_code]"   <<Command>>    as cmdInvite
rectangle "MemberInvited"                     <<Event>>      as evtInvited
rectangle "SendInvitationEmail"               <<Policy>>     as polEmail
rectangle "EmailService"                      <<External>>   as sysEmail
rectangle "Pending Invitations\n[read model]" <<ReadModel>>  as rmPending

admin      -->  cmdInvite
cmdInvite  -->  aggInvite
aggInvite  -->  evtInvited
evtInvited -[#6A1B9A]->  polEmail  : triggers
polEmail   -->  sysEmail
evtInvited -->  rmPending

' ============================================================
' ACCEPT INVITATION FLOW
' ============================================================
rectangle "AcceptInvitation\n[token]"      <<Command>>    as cmdAccept
rectangle "InvitationAccepted"              <<Event>>      as evtAccepted
rectangle "CreateMembership"               <<Policy>>     as polMembership
rectangle "MemberJoined"                   <<Event>>      as evtJoined
rectangle "AssignDefaultRole"              <<Policy>>     as polRole
rectangle "RoleAssigned"                   <<Event>>      as evtRole
rectangle "Workspace Members\n[read model]" <<ReadModel>> as rmMembers

invitee     -->  cmdAccept
cmdAccept   -->  aggInvite
aggInvite   -->  evtAccepted
evtAccepted -[#6A1B9A]->  polMembership : triggers
polMembership -->  aggMember
aggMember   -->  evtJoined
evtJoined   -[#6A1B9A]->  polRole : triggers
polRole     -->  evtRole
evtJoined   -->  rmMembers

' ============================================================
' REVOKE INVITATION FLOW
' ============================================================
rectangle "RevokeInvitation\n[invitation_id]"  <<Command>>  as cmdRevoke
rectangle "InvitationRevoked"                   <<Event>>    as evtRevoked

admin      -->  cmdRevoke
cmdRevoke  -->  aggInvite
aggInvite  -->  evtRevoked
evtRevoked -->  rmPending : removes

' ============================================================
' LEAVE WORKSPACE FLOW
' ============================================================
rectangle "LeaveWorkspace"   <<Command>>  as cmdLeave
rectangle "MemberLeft"       <<Event>>    as evtLeft

member     -->  cmdLeave
cmdLeave   -->  aggMember
aggMember  -->  evtLeft
evtLeft    -->  rmMembers : updates

' ============================================================
' REMOVE MEMBER FLOW
' ============================================================
rectangle "RemoveMember\n[member_id]"  <<Command>>  as cmdRemove
rectangle "MemberRemoved"               <<Event>>    as evtRemoved
rectangle "RevokeChannelAccess"         <<Policy>>   as polRevoke

admin      -->  cmdRemove
cmdRemove  -->  aggMember
aggMember  -->  evtRemoved
evtRemoved -[#6A1B9A]->  polRevoke : triggers
evtRemoved -->  rmMembers : updates

@enduml
