@startuml 00_overview_agg
title Phase 1 - Aggregate Design Overview

skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor<<AggregateRoot>>  #F9A825
  BorderColor<<AggregateRoot>>      #F57F17
  FontColor<<AggregateRoot>>        #212121
  BackgroundColor<<Entity>>         #E3F2FD
  BorderColor<<Entity>>             #1565C0
  FontColor<<Entity>>               #212121
  BackgroundColor<<ValueObject>>    #F3E5F5
  BorderColor<<ValueObject>>        #7B1FA2
  FontColor<<ValueObject>>          #212121
}

' ============================================================
' USER AGGREGATE
' ============================================================
package "User Aggregate" #E8F5E9 {
  class users <<AggregateRoot>> {
    + id : bigint
    + uuid : char(36)
    + email : varchar(255)
    + status : varchar(30)
    --
    register()
    verifyEmail()
    login()
    logout()
    updateProfile()
    requestPasswordReset()
    resetPassword()
  }
  class user_profiles <<Entity>> {
    + user_id : bigint
    + display_name : varchar
    + avatar_url : varchar
    + status : varchar(30)
  }
  class user_settings <<Entity>> {
    + user_id : bigint
    + notifications_json : json
    + preferences_json : json
  }
  class user_sessions <<Entity>> {
    + id : bigint
    + session_token : varchar
    + expires_at : datetime
  }
  class password_resets <<Entity>> {
    + id : bigint
    + token_hash : varchar
    + expires_at : datetime
  }
  users "1" *-- "1" user_profiles
  users "1" *-- "1" user_settings
  users "1" *-- "0..*" user_sessions
  users "1" *-- "0..*" password_resets
}

' ============================================================
' WORKSPACE AGGREGATE
' ============================================================
package "Workspace Aggregate" #E3F2FD {
  class tenants <<AggregateRoot>> {
    + id : bigint
    + uuid : char(36)
    + slug : varchar(100)
    + status : varchar(30)
    --
    create()
    update()
    suspend()
    activate()
    delete()
  }
  class plans <<ValueObject>> {
    + id : bigint
    + code : varchar(50)
    + max_members : int
    + max_channels : int
    + features_json : json
  }
  tenants "0..*" --* "1" plans
}

' ============================================================
' MEMBERSHIP AGGREGATE
' ============================================================
package "Membership Aggregate" #FFF9C4 {
  class tenant_members <<AggregateRoot>> {
    + id : bigint
    + tenant_id : bigint
    + user_id : bigint
    + status : varchar(30)
    --
    join()
    leave()
    suspend()
    remove()
  }
  class invitations <<Entity>> {
    + id : bigint
    + token : varchar(255)
    + invite_type : varchar(30)
    + status : varchar(30)
    + expires_at : datetime
    --
    send()
    accept()
    revoke()
    expire()
  }
  tenant_members "1" --* "0..*" invitations : accepted via
}

' ============================================================
' CHANNEL AGGREGATE
' ============================================================
package "Channel Aggregate" #FFF3E0 {
  class channels <<AggregateRoot>> {
    + id : bigint
    + uuid : char(36)
    + channel_type : varchar(30)
    + status : varchar(30)
    --
    create()
    update()
    archive()
  }
  class channel_members <<Entity>> {
    + id : bigint
    + status : varchar(30)
    + notification_level : varchar
    --
    join()
    leave()
    remove()
    updateSettings()
  }
  channels "1" *-- "0..*" channel_members
}

' ============================================================
' MESSAGE AGGREGATE
' ============================================================
package "Message Aggregate" #FCE4EC {
  class messages <<AggregateRoot>> {
    + id : bigint
    + uuid : char(36)
    + message_type : varchar(30)
    + content_text : text
    --
    send()
    edit()
    delete()
    reply()
  }
  class message_reads <<Entity>> {
    + id : bigint
    + last_read_at : datetime
    --
    markRead()
  }
  class message_pins <<Entity>> {
    + id : bigint
    + pinned_at : datetime
    --
    pin()
    unpin()
  }
  class message_attachments <<Entity>> {
    + id : bigint
    + file_name : varchar
    + mime_type : varchar
    + file_size : bigint
  }
  messages "1" *-- "0..*" message_reads
  messages "1" *-- "0..*" message_pins
  messages "1" *-- "0..*" message_attachments
  messages "0..*" -- "0..1" messages : parent thread
}

' ============================================================
' RBAC AGGREGATE
' ============================================================
package "RBAC Aggregate" #F3E5F5 {
  class roles <<AggregateRoot>> {
    + id : bigint
    + scope_type : varchar(30)
    + code : varchar(50)
    + is_system : boolean
    --
    create()
    grantPermission()
    revokePermission()
    assignToMember()
    revokeFromMember()
  }
  class permissions <<Entity>> {
    + id : bigint
    + code : varchar(100)
    + scope_type : varchar(30)
  }
  class role_permissions <<Entity>> {
    + role_id : bigint
    + permission_id : bigint
  }
  class tenant_member_roles <<Entity>> {
    + tenant_member_id : bigint
    + role_id : bigint
    + assigned_at : datetime
  }
  class channel_member_roles <<Entity>> {
    + channel_member_id : bigint
    + role_id : bigint
    + assigned_at : datetime
  }
  roles "1" *-- "0..*" role_permissions
  permissions "1" *-- "0..*" role_permissions
  roles "1" *-- "0..*" tenant_member_roles
  roles "1" *-- "0..*" channel_member_roles
}

' ============================================================
' CROSS-AGGREGATE DEPENDENCIES (via Domain Events / IDs)
' ============================================================
tenants          ..>  tenant_members      : workspace_id
users            ..>  tenant_members      : user_id
users            ..>  tenants             : owner_user_id
tenant_members   ..>  tenant_member_roles : referenced by
channel_members  ..>  channel_member_roles: referenced by
tenants          ..>  channels            : tenant_id
channels         ..>  channel_members     : channel_id
channels         ..>  messages            : channel_id
users            ..>  messages            : sender_user_id

note bottom of tenants
  Cross-aggregate refs use IDs only.
  No direct object references.
  Communication via Domain Events.
end note

@enduml
