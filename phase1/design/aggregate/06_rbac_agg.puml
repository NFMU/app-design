@startuml 06_rbac_agg
title RBAC Aggregate - Detail Design

skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor<<AggregateRoot>> #F9A825
  BorderColor<<AggregateRoot>>     #F57F17
  BackgroundColor<<Entity>>        #E3F2FD
  BorderColor<<Entity>>            #1565C0
  BackgroundColor<<ValueObject>>   #F3E5F5
  BorderColor<<ValueObject>>       #7B1FA2
  BackgroundColor<<DomainEvent>>   #E65100
  BorderColor<<DomainEvent>>       #BF360C
  FontColor<<DomainEvent>>         white
}

package "RBAC Aggregate" #F3E5F5 {

  class roles <<AggregateRoot>> {
    + id : bigint               {PK}
    + tenant_id : bigint        {FK, nullable}
    + scope_type : varchar(30)
    + code : varchar(50)
    + name : varchar(100)
    + description : varchar(500)
    + is_system : boolean
    ==
    + createCustom(name, scope) : CustomRoleCreated
    + grantPermission(perm_id) : PermissionGranted
    + revokePermission(perm_id) : PermissionRevoked
    + assignToTenantMember(member_id) : TenantRoleAssigned
    + revokeFromTenantMember(member_id) : TenantRoleRevoked
    + assignToChannelMember(member_id) : ChannelRoleAssigned
    + revokeFromChannelMember(member_id) : ChannelRoleRevoked
  }

  class permissions <<ValueObject>> {
    + id : bigint              {PK}
    + scope_type : varchar(30)
    + code : varchar(100)      {UQ}
    + name : varchar(255)
    + description : varchar(500)
    --
    ' Examples:
    ' tenant.member.invite
    ' tenant.settings.update
    ' channel.message.send
    ' channel.member.remove
  }

  class role_permissions <<Entity>> {
    + id : bigint              {PK}
    + role_id : bigint         {FK}
    + permission_id : bigint   {FK}
  }

  class tenant_member_roles <<Entity>> {
    + id : bigint                {PK}
    + tenant_member_id : bigint  {FK}
    + role_id : bigint           {FK}
    + assigned_by : bigint       {FK}
    + assigned_at : datetime
  }

  class channel_member_roles <<Entity>> {
    + id : bigint                 {PK}
    + channel_member_id : bigint  {FK}
    + role_id : bigint            {FK}
    + assigned_by : bigint        {FK}
    + assigned_at : datetime
  }

  roles       "1" *-- "0..*" role_permissions
  permissions "1" *-- "0..*" role_permissions
  roles       "1" *-- "0..*" tenant_member_roles
  roles       "1" *-- "0..*" channel_member_roles
}

package "Domain Events" #FBE9E7 {
  class SystemRolesSeeded    <<DomainEvent>>
  class CustomRoleCreated    <<DomainEvent>>
  class PermissionGranted    <<DomainEvent>>
  class PermissionRevoked    <<DomainEvent>>
  class TenantRoleAssigned   <<DomainEvent>>
  class TenantRoleRevoked    <<DomainEvent>>
  class ChannelRoleAssigned  <<DomainEvent>>
  class ChannelRoleRevoked   <<DomainEvent>>
}

roles ..> SystemRolesSeeded
roles ..> CustomRoleCreated
roles ..> PermissionGranted
roles ..> PermissionRevoked
roles ..> TenantRoleAssigned
roles ..> TenantRoleRevoked
roles ..> ChannelRoleAssigned
roles ..> ChannelRoleRevoked

note right of roles
  System roles (is_system = true):
  - owner  : full workspace control
  - admin  : manage members & channels
  - member : standard access
  These are seeded at workspace creation.
end note

note right of permissions
  Scope types:
  - tenant : workspace-level permissions
  - channel: channel-level permissions
  Permission check: roles → role_permissions
  → permissions.code → allow/deny
end note

@enduml
