@startuml 01_user_agg
title User Aggregate - Detail Design

skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor<<AggregateRoot>> #F9A825
  BorderColor<<AggregateRoot>>     #F57F17
  BackgroundColor<<Entity>>        #E3F2FD
  BorderColor<<Entity>>            #1565C0
  BackgroundColor<<ValueObject>>   #F3E5F5
  BorderColor<<ValueObject>>       #7B1FA2
  BackgroundColor<<DomainEvent>>   #E65100
  BorderColor<<DomainEvent>>       #BF360C
  FontColor<<DomainEvent>>         white
  BackgroundColor<<Command>>       #1565C0
  BorderColor<<Command>>           #0D47A1
  FontColor<<Command>>             white
}

package "User Aggregate" #E8F5E9 {

  ' --- Aggregate Root ---
  class users <<AggregateRoot>> {
    + id : bigint        {PK}
    + uuid : char(36)    {UQ}
    + email : varchar    {UQ}
    + password_hash : varchar
    + status : varchar(30)
    + auth_provider : varchar(30)
    + email_verified_at : datetime
    + last_login_at : datetime
    + created_at : datetime
    + updated_at : datetime
    + deleted_at : datetime
    ==
    + register(email, password) : UserRegistered
    + verifyEmail(token) : EmailVerified
    + login(email, password) : UserLoggedIn
    + logout(session_id) : UserLoggedOut
    + updateProfile(data) : ProfileUpdated
    + changePassword(old, new) : PasswordChanged
    + requestPasswordReset(email) : PasswordResetRequested
    + resetPassword(token, new) : PasswordReset
    + suspend() : UserSuspended
    + delete() : UserDeleted
  }

  ' --- Entities ---
  class user_profiles <<Entity>> {
    + user_id : bigint   {PK, FK}
    + display_name : varchar(255)
    + avatar_url : varchar(500)
    + job_title : varchar(255)
    + phone : varchar(50)
    + language_code : varchar(10)
    + timezone : varchar(50)
    + status : varchar(30)
    + bio : varchar(500)
  }

  class user_settings <<Entity>> {
    + user_id : bigint   {PK, FK}
    + notifications_json : json
    + preferences_json : json
  }

  class user_sessions <<Entity>> {
    + id : bigint        {PK}
    + user_id : bigint   {FK}
    + session_token : varchar  {UQ}
    + refresh_token_hash : varchar
    + ip_address : varchar(64)
    + device_name : varchar(255)
    + last_seen_at : datetime
    + expires_at : datetime
    + revoked_at : datetime
  }

  class password_resets <<Entity>> {
    + id : bigint        {PK}
    + user_id : bigint   {FK}
    + token_hash : varchar  {UQ}
    + expires_at : datetime
    + used_at : datetime
  }

  ' --- Relationships ---
  users "1" *-down- "1"    user_profiles  : has
  users "1" *-down- "1"    user_settings  : has
  users "1" *-right- "0..*" user_sessions  : opens
  users "1" *-left-  "0..*" password_resets : requests
}

' --- Domain Events emitted ---
package "Domain Events" #FBE9E7 {
  class UserRegistered         <<DomainEvent>>
  class EmailVerified          <<DomainEvent>>
  class UserLoggedIn           <<DomainEvent>>
  class UserLoggedOut          <<DomainEvent>>
  class ProfileUpdated         <<DomainEvent>>
  class PasswordReset          <<DomainEvent>>
  class PasswordResetRequested <<DomainEvent>>
  class UserSuspended          <<DomainEvent>>
  class UserDeleted            <<DomainEvent>>
}

users ..> UserRegistered
users ..> EmailVerified
users ..> UserLoggedIn
users ..> UserLoggedOut
users ..> ProfileUpdated
users ..> PasswordReset
users ..> PasswordResetRequested
users ..> UserSuspended
users ..> UserDeleted

@enduml
