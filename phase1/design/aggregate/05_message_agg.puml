@startuml 05_message_agg
title Message Aggregate - Detail Design

skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor<<AggregateRoot>> #F9A825
  BorderColor<<AggregateRoot>>     #F57F17
  BackgroundColor<<Entity>>        #E3F2FD
  BorderColor<<Entity>>            #1565C0
  BackgroundColor<<ValueObject>>   #F3E5F5
  BorderColor<<ValueObject>>       #7B1FA2
  BackgroundColor<<DomainEvent>>   #E65100
  BorderColor<<DomainEvent>>       #BF360C
  FontColor<<DomainEvent>>         white
}

package "Message Aggregate" #FCE4EC {

  class messages <<AggregateRoot>> {
    + id : bigint                    {PK}
    + uuid : char(36)                {UQ}
    + channel_id : bigint            {FK}
    + sender_user_id : bigint        {FK}
    + parent_message_id : bigint     {FK, nullable}
    + message_type : varchar(30)
    + content_text : text
    + metadata_json : json
    + edited_at : datetime
    + edited_by : bigint             {FK, nullable}
    + deleted_at : datetime
    + deleted_by : bigint            {FK, nullable}
    + created_at : datetime
    ==
    + send(channel_id, content) : MessageSent
    + reply(parent_id, content) : MessageReplied
    + edit(content) : MessageEdited
    + softDelete(by) : MessageDeleted
  }

  class message_reads <<Entity>> {
    + id : bigint                     {PK}
    + channel_id : bigint             {FK}
    + user_id : bigint                {FK}
    + last_read_message_id : bigint   {FK}
    + last_read_at : datetime
    ==
    + markRead(message_id) : ChannelMarkedRead
  }

  class message_pins <<Entity>> {
    + id : bigint           {PK}
    + channel_id : bigint   {FK}
    + message_id : bigint   {FK}
    + pinned_by : bigint    {FK}
    + pinned_at : datetime
    + unpinned_at : datetime
    ==
    + pin(by) : MessagePinned
    + unpin() : MessageUnpinned
  }

  class message_attachments <<Entity>> {
    + id : bigint              {PK}
    + message_id : bigint      {FK}
    + file_name : varchar(255)
    + mime_type : varchar(100)
    + file_size : bigint
    + storage_path : varchar(1000)
    + url : varchar(1000)
    + thumbnail_url : varchar(1000)
  }

  messages "1"    *--  "0..*"  message_reads       : read by
  messages "1"    *--  "0..*"  message_pins        : pinned as
  messages "1"    *--  "0..*"  message_attachments : has
  messages "0..*" --   "0..1"  messages            : reply to
}

package "Domain Events" #FBE9E7 {
  class MessageSent     <<DomainEvent>>
  class MessageReplied  <<DomainEvent>>
  class MessageEdited   <<DomainEvent>>
  class MessageDeleted  <<DomainEvent>>
  class ChannelMarkedRead <<DomainEvent>>
  class MessagePinned   <<DomainEvent>>
  class MessageUnpinned <<DomainEvent>>
  class FileAttached    <<DomainEvent>>
}

messages        ..> MessageSent
messages        ..> MessageReplied
messages        ..> MessageEdited
messages        ..> MessageDeleted
message_reads   ..> ChannelMarkedRead
message_pins    ..> MessagePinned
message_pins    ..> MessageUnpinned
message_attachments ..> FileAttached

note right of MessageSent
  Triggers policy:
  - Push notification to channel members
  - Increment unread count
  - Update last_message_at on channel
end note

note right of MessageDeleted
  Soft delete only.
  Content replaced with
  "[message deleted]" in read model.
end note

@enduml
