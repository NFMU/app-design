@startuml 04_channel_agg
title Channel Aggregate - Detail Design

skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor<<AggregateRoot>> #F9A825
  BorderColor<<AggregateRoot>>     #F57F17
  BackgroundColor<<Entity>>        #E3F2FD
  BorderColor<<Entity>>            #1565C0
  BackgroundColor<<ValueObject>>   #F3E5F5
  BorderColor<<ValueObject>>       #7B1FA2
  BackgroundColor<<DomainEvent>>   #E65100
  BorderColor<<DomainEvent>>       #BF360C
  FontColor<<DomainEvent>>         white
}

package "Channel Aggregate" #FFF3E0 {

  class channels <<AggregateRoot>> {
    + id : bigint            {PK}
    + uuid : char(36)        {UQ}
    + tenant_id : bigint     {FK}
    + created_by : bigint    {FK}
    + name : varchar(255)
    + slug : varchar(255)    {UQ}
    + channel_type : varchar(30)
    + description : text
    + topic : varchar(500)
    + status : varchar(30)
    + settings_json : json
    ==
    + create(name, type) : ChannelCreated
    + update(data) : ChannelUpdated
    + archive() : ChannelArchived
    + addMember(user_id) : ChannelMemberAdded
    + removeMember(member_id) : ChannelMemberRemoved
    + updateMemberSettings(data) : MemberSettingsUpdated
  }

  class channel_members <<Entity>> {
    + id : bigint              {PK}
    + channel_id : bigint      {FK}
    + user_id : bigint         {FK}
    + added_by : bigint        {FK}
    + status : varchar(30)
    + notification_level : varchar(30)
    + is_pinned : boolean
    + display_order : int
    + joined_at : datetime
    + left_at : datetime
    ==
    + join() : ChannelMemberAdded
    + leave() : ChannelMemberLeft
    + updateNotifications(level) : MemberSettingsUpdated
    + pin() / unpin() : MemberSettingsUpdated
  }

  channels "1" *-- "0..*" channel_members : has
}

package "Domain Events" #FBE9E7 {
  class ChannelCreated        <<DomainEvent>>
  class ChannelUpdated        <<DomainEvent>>
  class ChannelArchived       <<DomainEvent>>
  class ChannelMemberAdded    <<DomainEvent>>
  class ChannelMemberLeft     <<DomainEvent>>
  class ChannelMemberRemoved  <<DomainEvent>>
  class MemberSettingsUpdated <<DomainEvent>>
}

channels        ..> ChannelCreated
channels        ..> ChannelUpdated
channels        ..> ChannelArchived
channel_members ..> ChannelMemberAdded
channel_members ..> ChannelMemberLeft
channel_members ..> ChannelMemberRemoved
channel_members ..> MemberSettingsUpdated

note right of ChannelCreated
  Triggers policy:
  - Add creator as channel admin
end note

note right of ChannelArchived
  Triggers policy:
  - Notify all channel members
  - Set read-only mode
end note

@enduml
