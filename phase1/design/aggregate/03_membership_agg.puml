@startuml 03_membership_agg
title Membership Aggregate - Detail Design

skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor<<AggregateRoot>> #F9A825
  BorderColor<<AggregateRoot>>     #F57F17
  BackgroundColor<<Entity>>        #E3F2FD
  BorderColor<<Entity>>            #1565C0
  BackgroundColor<<ValueObject>>   #F3E5F5
  BorderColor<<ValueObject>>       #7B1FA2
  BackgroundColor<<DomainEvent>>   #E65100
  BorderColor<<DomainEvent>>       #BF360C
  FontColor<<DomainEvent>>         white
}

package "Membership Aggregate" #FFF9C4 {

  class tenant_members <<AggregateRoot>> {
    + id : bigint          {PK}
    + tenant_id : bigint   {FK}
    + user_id : bigint     {FK}
    + invited_by : bigint  {FK}
    + status : varchar(30)
    + joined_at : datetime
    + left_at : datetime
    + removed_at : datetime
    ==
    + join(tenant_id, user_id) : MemberJoined
    + leave() : MemberLeft
    + suspend() : MemberSuspended
    + reactivate() : MemberReactivated
    + remove(by) : MemberRemoved
  }

  class invitations <<Entity>> {
    + id : bigint              {PK}
    + tenant_id : bigint       {FK}
    + channel_id : bigint      {FK, nullable}
    + invited_by : bigint      {FK}
    + accepted_by_user_id : bigint {FK, nullable}
    + email : varchar(255)
    + invite_type : varchar(30)
    + token : varchar(255)     {UQ}
    + role_scope : varchar(30)
    + role_code : varchar(50)
    + status : varchar(30)
    + expires_at : datetime
    + accepted_at : datetime
    ==
    + send(email, role) : MemberInvited
    + accept(user_id) : InvitationAccepted
    + revoke() : InvitationRevoked
    + expire() : InvitationExpired
  }

  tenant_members "1" --o "0..*" invitations : joined via
}

package "Domain Events" #FBE9E7 {
  class MemberInvited      <<DomainEvent>>
  class InvitationAccepted <<DomainEvent>>
  class InvitationRevoked  <<DomainEvent>>
  class InvitationExpired  <<DomainEvent>>
  class MemberJoined       <<DomainEvent>>
  class MemberLeft         <<DomainEvent>>
  class MemberSuspended    <<DomainEvent>>
  class MemberReactivated  <<DomainEvent>>
  class MemberRemoved      <<DomainEvent>>
}

invitations    ..> MemberInvited
invitations    ..> InvitationAccepted
invitations    ..> InvitationRevoked
invitations    ..> InvitationExpired
tenant_members ..> MemberJoined
tenant_members ..> MemberLeft
tenant_members ..> MemberSuspended
tenant_members ..> MemberReactivated
tenant_members ..> MemberRemoved

note right of InvitationAccepted
  Triggers policy:
  - Create tenant_member record
  - Assign default role
end note

note right of MemberRemoved
  Triggers policy:
  - Remove from all channels
  - Revoke all roles
end note

@enduml
