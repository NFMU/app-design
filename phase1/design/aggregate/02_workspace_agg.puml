@startuml 02_workspace_agg
title Workspace Aggregate - Detail Design

skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor<<AggregateRoot>> #F9A825
  BorderColor<<AggregateRoot>>     #F57F17
  BackgroundColor<<Entity>>        #E3F2FD
  BorderColor<<Entity>>            #1565C0
  BackgroundColor<<ValueObject>>   #F3E5F5
  BorderColor<<ValueObject>>       #7B1FA2
  BackgroundColor<<DomainEvent>>   #E65100
  BorderColor<<DomainEvent>>       #BF360C
  FontColor<<DomainEvent>>         white
}

package "Workspace Aggregate" #E3F2FD {

  class tenants <<AggregateRoot>> {
    + id : bigint          {PK}
    + uuid : char(36)      {UQ}
    + plan_id : bigint     {FK}
    + owner_user_id : bigint {FK}
    + created_by : bigint  {FK}
    + name : varchar(255)
    + slug : varchar(100)  {UQ}
    + domain : varchar(255)
    + status : varchar(30)
    + timezone : varchar(50)
    + locale : varchar(10)
    + branding_json : json
    + settings_json : json
    + activated_at : datetime
    + suspended_at : datetime
    ==
    + create(name, slug, plan_id) : WorkspaceCreated
    + update(data) : WorkspaceUpdated
    + changePlan(plan_id) : PlanChanged
    + suspend() : WorkspaceSuspended
    + activate() : WorkspaceActivated
    + delete() : WorkspaceDeleted
    + updateSettings(json) : WorkspaceSettingsUpdated
    + updateBranding(json) : WorkspaceBrandingUpdated
  }

  class plans <<ValueObject>> {
    + id : bigint        {PK}
    + code : varchar(50) {UQ}
    + name : varchar(100)
    + max_members : int
    + max_channels : int
    + max_storage_gb : int
    + features_json : json
    + status : varchar(30)
  }

  tenants "0..*" --* "1" plans : subscribed to
}

package "Domain Events" #FBE9E7 {
  class WorkspaceCreated          <<DomainEvent>>
  class WorkspaceUpdated          <<DomainEvent>>
  class PlanChanged               <<DomainEvent>>
  class WorkspaceSuspended        <<DomainEvent>>
  class WorkspaceActivated        <<DomainEvent>>
  class WorkspaceDeleted          <<DomainEvent>>
  class WorkspaceSettingsUpdated  <<DomainEvent>>
  class WorkspaceBrandingUpdated  <<DomainEvent>>
}

tenants ..> WorkspaceCreated
tenants ..> WorkspaceUpdated
tenants ..> PlanChanged
tenants ..> WorkspaceSuspended
tenants ..> WorkspaceActivated
tenants ..> WorkspaceDeleted
tenants ..> WorkspaceSettingsUpdated
tenants ..> WorkspaceBrandingUpdated

note right of WorkspaceDeleted
  Triggers policy:
  - Archive all channels
  - Revoke all memberships
  - Expire pending invitations
end note

@enduml
