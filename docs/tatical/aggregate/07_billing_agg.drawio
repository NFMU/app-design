        <mxCell id="note" value="Cross-context references stay ID-based: tenant_id, plan_id, plan_price_id, billing_policy_id, and provider references. Raw payment credentials are external to the platform." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1110" y="30" width="430" height="96" as="geometry" /></mxCell>
