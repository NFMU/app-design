        <mxCell id="root" value="&lt;table style=&quot;width:100%;height:100%;border-collapse:collapse;font-size:11px;font-family:Arial;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#F9A825;color:#212121;font-weight:bold;text-align:center;border:1px solid #7F8C8D;padding:4px;&quot;&gt;subscriptions&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCD1D1;background:#FFF8E1;padding:4px;vertical-align:top;&quot;&gt;Aggregate Root: subscription lifecycle&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCD1D1;background:#FFF8E1;padding:4px;vertical-align:top;&quot;&gt;Identity: id, tenant_id, provider_subscription_ref&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCD1D1;background:#FFF8E1;padding:4px;vertical-align:top;&quot;&gt;References: plan_id, plan_price_id, billing_profile_id, billing_policy_id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCD1D1;background:#FFF8E1;padding:4px;vertical-align:top;&quot;&gt;Lifecycle: start(), change_plan(), cancel(), recover_payment()&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCD1D1;background:#FFF8E1;padding:4px;vertical-align:top;&quot;&gt;Controls: mark_past_due(), mark_unpaid(), apply_override()&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#FFFFFF;strokeColor=#7F8C8D;overflow=fill;" vertex="1" parent="1"><mxGeometry x="120" y="160" width="460" height="178" as="geometry" /></mxCell>
        <mxCell id="billing_profiles" value="&lt;table style=&quot;width:100%;height:100%;border-collapse:collapse;font-size:11px;font-family:Arial;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#85C1E9;color:#0B3C5D;font-weight:bold;text-align:center;border:1px solid #7F8C8D;padding:4px;&quot;&gt;billing_profiles&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCD1D1;background:#FDFEFE;padding:4px;vertical-align:top;&quot;&gt;Entity: tenant billing account details&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCD1D1;background:#FDFEFE;padding:4px;vertical-align:top;&quot;&gt;billing_email, company_name, tax_id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CCD1D1;background:#FDFEFE;padding:4px;vertical-align:top;&quot;&gt;invoice_delivery_preferences_json&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#FFFFFF;strokeColor=#7F8C8D;overflow=fill;" vertex="1" parent="1"><mxGeometry x="690" y="160" width="360" height="106" as="geometry" /></mxCell>
